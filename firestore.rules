    function isValidScholarControl(controlId) {
      return isTeacherEditor()
        && controlId == request.resource.data.scholarFirstNameKey
        && request.resource.data.keys().hasOnly([
          'action',
          'commandId',
          'gameControls',
          'lockedLevelIndexes',
          'masteryCounts',
          'masteryOverrideLevelIndexes',
          'restartLevelIndex',
          'scholarFirstName',
          'scholarFirstNameKey',
          'teacherEmail',
          'unlockedLevelIndexes',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'action',
          'commandId',
          'gameControls',
          'lockedLevelIndexes',
          'masteryCounts',
          'masteryOverrideLevelIndexes',
          'restartLevelIndex',
          'scholarFirstName',
          'scholarFirstNameKey',
          'teacherEmail',
          'unlockedLevelIndexes',
          'updatedAt'
        ])
        && request.resource.data.action == 'manage-game-levels'
        && request.resource.data.commandId is string
        && request.resource.data.commandId.matches('^[A-Za-z0-9-]{10,80}$')
        && isValidName(request.resource.data.scholarFirstName)
        && isValidNameKey(request.resource.data.scholarFirstNameKey)
        && isValidManagedGameControls(request.resource.data.gameControls)
        && request.resource.data.masteryCounts is list
        && request.resource.data.masteryCounts.size() == 6
        && request.resource.data.masteryCounts[0] >= 0 && request.resource.data.masteryCounts[0] <= 3
        && request.resource.data.masteryCounts[1] >= 0 && request.resource.data.masteryCounts[1] <= 3
        && request.resource.data.masteryCounts[2] >= 0 && request.resource.data.masteryCounts[2] <= 3
        && request.resource.data.masteryCounts[3] >= 0 && request.resource.data.masteryCounts[3] <= 3
        && request.resource.data.masteryCounts[4] >= 0 && request.resource.data.masteryCounts[4] <= 3
        && request.resource.data.masteryCounts[5] >= 0 && request.resource.data.masteryCounts[5] <= 3
        && request.resource.data.masteryOverrideLevelIndexes is list
        && request.resource.data.masteryOverrideLevelIndexes.size() <= 6
        && request.resource.data.lockedLevelIndexes is list
        && request.resource.data.lockedLevelIndexes.size() <= 6
        && request.resource.data.restartLevelIndex is int
        && request.resource.data.restartLevelIndex >= -1
        && request.resource.data.restartLevelIndex <= 5
        && request.resource.data.unlockedLevelIndexes is list
        && request.resource.data.unlockedLevelIndexes.size() <= 6
        && request.resource.data.teacherEmail == request.auth.token.email
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidPreassessmentStatus(statusId) {
      return (
          (
            statusId.matches('^math-starting-point-quest-[a-z]{1,30}$')
            && request.resource.data.gameId == 'math-starting-point-quest'
            && request.resource.data.subject == 'math'
          )
          || (
            statusId.matches('^skills-starting-point-[a-z]{1,30}$')
            && request.resource.data.gameId == 'skills-starting-point'
            && request.resource.data.subject == 'skills'
          )
        )
        && request.resource.data.keys().hasOnly([
          'assessmentId',
          'assessmentVersion',
          'categoryScores',
          'completedAt',
          'completedRetakeCommandId',
          'createdAt',
          'gameId',
          'learningLocation',
          'scholarFirstName',
          'scholarFirstNameKey',
          'score',
          'subject',
          'totalQuestions',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'completedAt',
          'createdAt',
          'gameId',
          'scholarFirstName',
          'scholarFirstNameKey',
          'score',
          'subject',
          'totalQuestions',
          'updatedAt'
        ])
        && isValidName(request.resource.data.scholarFirstName)
        && isValidNameKey(request.resource.data.scholarFirstNameKey)
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && request.resource.data.totalQuestions is int
        && request.resource.data.totalQuestions >= 1
        && request.resource.data.totalQuestions <= 100
        && request.resource.data.score <= request.resource.data.totalQuestions
        && (
          !request.resource.data.keys().hasAny(['completedRetakeCommandId'])
          || (
            request.resource.data.completedRetakeCommandId is string
            && request.resource.data.completedRetakeCommandId.size() >= 1
            && request.resource.data.completedRetakeCommandId.size() <= 80
          )
        )
        && isValidOptionalAssessmentMetadata()
        && isValidOptionalCategoryScores()
        && isValidOptionalLearningLocation()
        && request.resource.data.completedAt is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
    }

    function isValidPreassessmentControl(controlId) {
      return isTeacherEditor()
        && (
          controlId.matches('^math-starting-point-quest-[a-z]{1,30}$')
          || controlId.matches('^skills-starting-point-[a-z]{1,30}$')
        )
        && request.resource.data.keys().hasOnly([
          'action',
          'commandId',
          'scholarFirstNameKey',
          'teacherEmail',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'action',
          'commandId',
          'scholarFirstNameKey',
          'teacherEmail',
          'updatedAt'
        ])
        && request.resource.data.action in ['normal', 'retake', 'waived']
        && request.resource.data.commandId is string
        && request.resource.data.commandId.size() >= 1
        && request.resource.data.commandId.size() <= 80
        && isValidNameKey(request.resource.data.scholarFirstNameKey)
        && request.resource.data.teacherEmail == request.auth.token.email
        && request.resource.data.updatedAt is timestamp;
    }

    function canReadResult() {
      return isTeacherEditor();
    }

    function isValidQpsLiveSession(sessionId) {
      return sessionId.matches('^[a-z]{1,30}$')
        && request.resource.data.keys().hasOnly([
          'active',
          'createdAt',
          'currentIndex',
          'formId',
          'lastChangedBy',
          'schemaVersion',
          'scholarFirstName',
          'scholarFirstNameKey',
          'scholarId',
          'teacherEmail',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'active',
          'currentIndex',
          'formId',
          'lastChangedBy',
          'schemaVersion',
          'scholarFirstName',
          'scholarFirstNameKey',
          'scholarId',
          'teacherEmail',
          'updatedAt'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.active is bool
        && request.resource.data.currentIndex is int
        && request.resource.data.currentIndex >= 0
        && request.resource.data.currentIndex <= 220
        && request.resource.data.formId in ['A', 'B', 'C']
        && request.resource.data.lastChangedBy in ['teacher', 'scholar']
        && isValidName(request.resource.data.scholarFirstName)
        && request.resource.data.scholarFirstNameKey == sessionId
        && isValidNameKey(request.resource.data.scholarFirstNameKey)
        && request.resource.data.scholarId is string
        && request.resource.data.scholarId.size() > 0
        && request.resource.data.scholarId.size() <= 150
        && (
          isAuthorizedRosterTeacherEmail(request.resource.data.teacherEmail)
          || (
            sessionId == 'wcm'
            && request.resource.data.teacherEmail == 'unassigned'
            && request.resource.data.scholarId == 'whole-class-mode'
          )
        )
        && request.resource.data.updatedAt is timestamp
        && (
          !request.resource.data.keys().hasAny(['createdAt'])
          || request.resource.data.createdAt is timestamp
        );
    }

    function isValidPublicWholeClassQpsLiveSession(sessionId) {
      return sessionId == 'wcm'
        && request.resource.data.scholarFirstNameKey == 'wcm'
        && request.resource.data.scholarId == 'whole-class-mode'
        && request.resource.data.teacherEmail == 'unassigned'
        && isValidQpsLiveSession(sessionId);
    }

    function isValidScholarQpsLiveMove(sessionId) {
      return sessionId.matches('^[a-z]{1,30}$')
        && resource.data.active == true
        && resource.data.scholarFirstNameKey == sessionId
        && request.resource.data.diff(resource.data).changedKeys().hasOnly([
          'currentIndex',
          'lastChangedBy',
          'updatedAt'
        ])
        && request.resource.data.currentIndex is int
        && request.resource.data.currentIndex >= 0
        && request.resource.data.currentIndex <= 220
        && request.resource.data.lastChangedBy == 'scholar'
        && request.resource.data.updatedAt is timestamp;
    }

    match /gameHubCards/{cardId} {
      allow read: if true;
      allow create, update: if isTeacherEditor()
        && isValidCardId(cardId)
        && isValidCardEdit();
      allow delete: if isTeacherEditor()
        && isValidCardId(cardId);
    }

    match /gameHubTeacherLogs/{logId} {
      allow create: if isTeacherEditor()
        && isValidTeacherLog();
      allow read, delete: if isTeacherEditor();
      allow update: if false;
    }

    match /gameHubGameDefinitions/{gameId} {
      allow read: if isValidEditableGameId(gameId);
      allow create, update: if isTeacherEditor()
        && isValidEditableGameId(gameId)
        && isValidEditableGameDefinition(gameId);
      allow delete: if isTeacherEditor()
        && isValidEditableGameId(gameId);

      match /versions/{versionId} {
        allow read: if isTeacherEditor()
          || resource.data.status == 'published';
        allow create, update: if isTeacherEditor()
          && isValidEditableGameId(gameId)
          && isValidEditableGameVersion(versionId);
        allow delete: if isTeacherEditor()
          && isValidEditableGameId(gameId);
      }

      match /audioClips/{clipId} {
        allow read, write: if isTeacherEditor()
          && isValidEditableGameId(gameId);
      }
    }

    match /gameHubScholars/{scholarId} {
      allow create: if isTeacherEditor()
        && isValidScholar();
      allow read: if isTeacherEditor();
      allow delete: if canManageScholarRoster();
      allow update: if canManageScholarRoster()
        && isValidScholar();
    }

    match /gameHubSkillsDataOverrides/{overrideId} {
      allow read, delete: if isTeacherEditor();
      allow create, update: if isTeacherEditor()
        && isValidSkillsDataOverride();
    }

    match /gameHubResultSubmissions/{resultId} {
      allow create: if isValidIndividualResult()
        || isValidQpsResult()
        || isValidWholeClassMiss();
      allow read, delete: if canReadResult();
      allow update: if false;
    }

    match /gameHubProgressSubmissions/{progressId} {
      allow create, update: if isValidProgressSubmission(progressId);
      allow read, delete: if isTeacherEditor();
    }

    match /gameHubPreassessmentStatus/{statusId} {
      allow get: if statusId.matches('^math-starting-point-quest-[a-z]{1,30}$')
        || statusId.matches('^skills-starting-point-[a-z]{1,30}$');
      allow list: if isTeacherEditor();
      allow create, update: if isValidPreassessmentStatus(statusId);
      allow delete: if isTeacherEditor();
    }

    match /gameHubPreassessmentControls/{controlId} {
      allow get: if controlId.matches('^math-starting-point-quest-[a-z]{1,30}$')
        || controlId.matches('^skills-starting-point-[a-z]{1,30}$');
      allow list: if isTeacherEditor();
      allow create, update: if isValidPreassessmentControl(controlId);
      allow delete: if isTeacherEditor();
    }

    match /gameHubQpsLiveSessions/{sessionId} {
      allow get: if sessionId.matches('^[a-z]{1,30}$');
      allow list: if isTeacherEditor();
      allow create: if (
          isTeacherEditor()
          && isValidQpsLiveSession(sessionId)
        ) || isValidPublicWholeClassQpsLiveSession(sessionId);
      allow update: if (
          isTeacherEditor()
          && isValidQpsLiveSession(sessionId)
        ) || isValidPublicWholeClassQpsLiveSession(sessionId)
        || isValidScholarQpsLiveMove(sessionId);
      allow delete: if isTeacherEditor();
    }

    match /gameHubScholarControls/{controlId} {
      allow get: if true;
      allow list: if isTeacherEditor();
      allow create, update: if isValidScholarControl(controlId);
      allow delete: if isTeacherEditor();
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}

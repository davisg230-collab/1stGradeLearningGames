rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isTeacherEditor() {
      return request.auth != null
        && request.auth.token.email in [
          'davisg230@gmail.com',
          'lvest1@crossroadsschoolskc.org',
          'lvest1010@gmail.com',
          'lvest@crossroadsschoolskc.org'
        ];
    }

    function isOwnedBySignedInTeacher() {
      return isTeacherEditor()
        && resource.data.teacherEmail == request.auth.token.email;
    }

    function isAuthorizedRosterTeacherEmail(email) {
      return email in [
        'davisg230@gmail.com',
        'lvest1@crossroadsschoolskc.org'
      ];
    }

    function canManageScholarRoster() {
      return isTeacherEditor()
        && isAuthorizedRosterTeacherEmail(resource.data.teacherEmail);
    }

    function isValidCardId(cardId) {
      return cardId.matches('^(CKLA Skills:(qps-screener|starting-point|letter-search-safari|unit-[0-9]+)|CKLA Listening & Learning:unit-[0-9]+|Eureka Math:module-[0-9]+|Math:(starting-point|number-search-safari))$');
    }

    function isValidName(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 40;
    }

    function isValidNameKey(value) {
      return value is string
        && value.matches('^[a-z]{1,30}$');
    }

    function isValidTrackingInitials(value) {
      return value is string
        && value.matches('^[A-Z]{1,3}$');
    }

    function isValidChoice(value) {
      return value is string
        && value.matches('^[A-Za-z0-9 _./-]{1,50}$');
    }

    function isValidReportChoice(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 120;
    }

    function isValidWord(value) {
      return value is string
        && value.size() > 0
        && value.size() <= 120;
    }

    function isValidPublicGameId(value) {
      return value in [
        'ckla-unit-1-word-builder-blast',
        'ckla-unit-2-long-vowel-quest',
        'letter-search-safari',
        'math-starting-point-quest',
        'number-search-safari',
        'qps-screener',
        'skills-starting-point',
        'unit1-zone1-sound-safari'
      ] || (
        value is string
        && (
          value.matches('^ckla-unit-[3-7]-skills-quest$')
          || value.matches('^ckla-listening-learning-unit-([1-9]|10|11)$')
          || value.matches('^eureka-math-module-[1-6]$')
        )
      );
    }

    function isSharedCklaUnitGame() {
      return request.resource.data.gameId == 'unit1-zone1-sound-safari'
        || request.resource.data.gameId == 'ckla-unit-2-long-vowel-quest'
        || request.resource.data.gameId == 'letter-search-safari'
        || request.resource.data.gameId == 'math-starting-point-quest'
        || request.resource.data.gameId == 'number-search-safari'
        || request.resource.data.gameId == 'skills-starting-point'
        || request.resource.data.gameId.matches('^ckla-unit-[3-7]-skills-quest$')
        || request.resource.data.gameId.matches('^ckla-listening-learning-unit-([1-9]|10|11)$')
        || request.resource.data.gameId.matches('^eureka-math-module-[1-6]$');
    }

    function isValidEditableGameId(gameId) {
      return gameId is string
        && gameId.matches('^[a-z0-9-]{3,80}$');
    }

    function isValidEditableGameDefinition(gameId) {
      return request.resource.data.keys().hasOnly([
          'createdAt',
          'draftVersion',
          'gameId',
          'publishedVersion',
          'schemaVersion',
          'subject',
          'title',
          'unitSlug',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.keys().hasAll([
          'gameId',
          'publishedVersion',
          'schemaVersion',
          'subject',
          'title',
          'unitSlug',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.gameId == gameId
        && isValidEditableGameId(request.resource.data.gameId)
        && request.resource.data.schemaVersion == 1
        && request.resource.data.subject in [
          'ckla',
          'ckla-listening-learning',
          'math'
        ]
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 120
        && request.resource.data.unitSlug is string
        && request.resource.data.unitSlug.matches('^[a-z0-9-]{3,80}$')
        && request.resource.data.publishedVersion is string
        && request.resource.data.publishedVersion.size() <= 80
        && (
          !request.resource.data.keys().hasAny(['draftVersion'])
          || request.resource.data.draftVersion == null
          || (
            request.resource.data.draftVersion is string
            && request.resource.data.draftVersion.size() <= 80
          )
        )
        && (
          !request.resource.data.keys().hasAny(['createdAt'])
          || request.resource.data.createdAt is timestamp
        )
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy == request.auth.token.email;
    }

    function isValidEditableGameContent() {
      return request.resource.data.content is map
        && request.resource.data.content.keys().hasOnly([
          'levels',
          'questions',
          'rapidGuessingVoice',
          'schemaVersion',
          'supplementalQuestions',
          'unitTitle',
          'zoneEncouragements'
        ])
        && request.resource.data.content.keys().hasAll([
          'levels',
          'questions',
          'schemaVersion'
        ])
        && request.resource.data.content.schemaVersion == 1
        && request.resource.data.content.levels is list
        && request.resource.data.content.levels.size() > 0
        && request.resource.data.content.levels.size() <= 40
        && request.resource.data.content.questions is list
        && request.resource.data.content.questions.size() <= 700
        && (
          !request.resource.data.content.keys().hasAny(['supplementalQuestions'])
          || (
            request.resource.data.content.supplementalQuestions is list
            && request.resource.data.content.supplementalQuestions.size() <= 700
          )
        )
        && (
          !request.resource.data.content.keys().hasAny(['unitTitle'])
          || (
            request.resource.data.content.unitTitle is string
            && request.resource.data.content.unitTitle.size() <= 120
          )
        )
        && (
          !request.resource.data.content.keys().hasAny(['rapidGuessingVoice'])
          || request.resource.data.content.rapidGuessingVoice is map
        )
        && (
          !request.resource.data.content.keys().hasAny(['zoneEncouragements'])
          || (
            request.resource.data.content.zoneEncouragements is map
            && request.resource.data.content.zoneEncouragements.size() <= 80
          )
        );
    }

    function isValidEditableGameVersion(versionId) {
      return request.resource.data.keys().hasOnly([
          'content',
          'createdAt',
          'schemaVersion',
          'status',
          'updatedAt',
          'updatedBy',
          'versionId'
        ])
        && request.resource.data.keys().hasAll([
          'content',
          'schemaVersion',
          'status',
          'updatedAt',
          'updatedBy',
          'versionId'
        ])
        && request.resource.data.versionId == versionId
        && request.resource.data.versionId is string
        && request.resource.data.versionId.size() > 0
        && request.resource.data.versionId.size() <= 80
        && request.resource.data.schemaVersion == 1
        && request.resource.data.status in [
          'draft',
          'published'
        ]
        && isValidEditableGameContent()
        && (
          !request.resource.data.keys().hasAny(['createdAt'])
          || request.resource.data.createdAt is timestamp
        )
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy == request.auth.token.email;
    }

    function isValidSkillsDataOverride() {
      return request.resource.data.keys().hasOnly([
          'createdAt',
          'note',
          'reportId',
          'scholarFirstName',
          'scholarFirstNameKey',
          'scholarId',
          'status',
          'target',
          'teacherEmail',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.keys().hasAll([
          'reportId',
          'scholarFirstName',
          'scholarFirstNameKey',
          'scholarId',
          'status',
          'target',
          'teacherEmail',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.reportId in [
          'letter-sounds',
          'digraphs',
          'number-recognition',
          'counting-quantities'
        ]
        && request.resource.data.scholarFirstName is string
        && request.resource.data.scholarFirstName.size() > 0
        && request.resource.data.scholarFirstName.size() <= 40
        && isValidNameKey(request.resource.data.scholarFirstNameKey)
        && request.resource.data.scholarId is string
        && request.resource.data.scholarId.size() > 0
        && request.resource.data.scholarId.size() <= 150
        && request.resource.data.status in [
          'mastered',
          'needs-review'
        ]
        && request.resource.data.target is string
        && (
          (
            request.resource.data.reportId in [
              'letter-sounds',
              'digraphs'
            ]
            && request.resource.data.target.matches('^[a-z]{1,3}$')
          )
          || (
            request.resource.data.reportId in [
              'number-recognition',
              'counting-quantities'
            ]
            && request.resource.data.target.matches('^([1-9]|1[0-9]|20)$')
          )
        )
        && isAuthorizedRosterTeacherEmail(request.resource.data.teacherEmail)
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy == request.auth.token.email
        && (
          !request.resource.data.keys().hasAny(['createdAt'])
          || request.resource.data.createdAt is timestamp
        )
        && (
          !request.resource.data.keys().hasAny(['note'])
          || (
            request.resource.data.note is string
            && request.resource.data.note.size() <= 500
          )
        );
    }

    function isSoundSafariLevelFieldsValid() {
      return request.resource.data.keys().hasAll([
          'levelId',
          'levelIndex',
          'levelName'
        ])
        && request.resource.data.levelId in [
          'level-1',
          'level-2',
          'level-3',
          'level-4',
          'level-5',
          'level-6'
        ]
        && request.resource.data.levelIndex is int
        && request.resource.data.levelIndex >= 0
        && request.resource.data.levelIndex <= 5
        && request.resource.data.levelName is string
        && request.resource.data.levelName in [
          'Back-to-School Basecamp',
          'Code Trail',
          'Digraph Crossing',
          'Spelling Ridge',
          'Sentence Springs',
          'Unit 1 Summit'
        ];
    }

    function isSoundSafariResultTotalsValid() {
      return isSoundSafariLevelFieldsValid()
        && request.resource.data.totalQuestions is int
        && request.resource.data.totalQuestions > 0
        && request.resource.data.totalQuestions <= 300
        && request.resource.data.score <= request.resource.data.totalQuestions
        && request.resource.data.missedCount <= request.resource.data.totalQuestions
        && request.resource.data.missedQuestions.size() <= request.resource.data.totalQuestions;
    }

    function isSharedCklaResultTotalsValid() {
      return request.resource.data.keys().hasAll([
          'levelId',
          'levelIndex',
          'levelName'
        ])
        && request.resource.data.levelId is string
        && request.resource.data.levelId.size() > 0
        && request.resource.data.levelId.size() <= 80
        && request.resource.data.levelIndex is int
        && request.resource.data.levelIndex >= 0
        && request.resource.data.levelIndex <= 39
        && request.resource.data.levelName is string
        && request.resource.data.levelName.size() > 0
        && request.resource.data.levelName.size() <= 120
        && request.resource.data.totalQuestions is int
        && request.resource.data.totalQuestions > 0
        && request.resource.data.totalQuestions <= 300
        && request.resource.data.score <= request.resource.data.totalQuestions
        && request.resource.data.missedCount <= request.resource.data.totalQuestions
        && request.resource.data.missedQuestions.size() <= request.resource.data.totalQuestions;
    }

    function isSharedCklaProgressTotalsValid() {
      return request.resource.data.keys().hasAll([
          'levelId',
          'levelIndex',
          'levelName'
        ])
        && request.resource.data.levelId is string
        && request.resource.data.levelId.size() > 0
        && request.resource.data.levelId.size() <= 80
        && request.resource.data.levelIndex is int
        && request.resource.data.levelIndex >= 0
        && request.resource.data.levelIndex <= 39
        && request.resource.data.levelName is string
        && request.resource.data.levelName.size() > 0
        && request.resource.data.levelName.size() <= 120
        && request.resource.data.totalQuestions is int
        && request.resource.data.totalQuestions > 0
        && request.resource.data.totalQuestions <= 300
        && request.resource.data.score <= request.resource.data.totalQuestions
        && request.resource.data.questionsCompleted <= request.resource.data.totalQuestions
        && request.resource.data.currentQuestionIndex <= request.resource.data.totalQuestions;
    }

    function isQpsProgressTotalsValid() {
      return request.resource.data.keys().hasAll([
          'levelId',
          'levelIndex',
          'levelName'
        ])
        && request.resource.data.levelId == 'qps-full-screener'
        && request.resource.data.levelIndex == 0
        && request.resource.data.levelName == 'QPS Screener'
        && request.resource.data.totalQuestions is int
        && request.resource.data.totalQuestions > 0
        && request.resource.data.totalQuestions <= 220
        && request.resource.data.score <= request.resource.data.totalQuestions
        && request.resource.data.questionsCompleted <= request.resource.data.totalQuestions
        && request.resource.data.currentQuestionIndex <= request.resource.data.totalQuestions;
    }

    function isSoundSafariProgressTotalsValid() {
      return isSoundSafariLevelFieldsValid()
        && request.resource.data.totalQuestions is int
        && request.resource.data.totalQuestions > 0
        && request.resource.data.totalQuestions <= 300
        && request.resource.data.score <= request.resource.data.totalQuestions
        && request.resource.data.questionsCompleted <= request.resource.data.totalQuestions
        && request.resource.data.currentQuestionIndex <= request.resource.data.totalQuestions;
    }

    function isSoundSafariMasteryFieldsValid() {
      return request.resource.data.keys().hasAll([
          'masteredLevel',
          'masteryCount',
          'masteryEarned',
          'masteryTarget',
          'soundSafariComplete'
        ])
        && request.resource.data.masteredLevel is bool
        && request.resource.data.masteryCount is int
        && request.resource.data.masteryCount >= 0
        && request.resource.data.masteryCount <= 3
        && request.resource.data.masteryEarned is bool
        && request.resource.data.masteryTarget == 3
        && request.resource.data.soundSafariComplete is bool;
    }

    function isValidOptionalCategoryScores() {
      return !request.resource.data.keys().hasAny(['categoryScores'])
        || request.resource.data.categoryScores is map;
    }

    function isValidOptionalResponseTimes() {
      return !request.resource.data.keys().hasAny(['responseTimesMs'])
        || (
          request.resource.data.responseTimesMs is list
          && request.resource.data.responseTimesMs.size() <= 300
        );
    }

    function isValidOptionalAssessmentMetadata() {
      return (
          !request.resource.data.keys().hasAny(['assessmentId'])
          || (
            request.resource.data.assessmentId is string
            && request.resource.data.assessmentId.matches('^[a-z0-9-]{3,80}$')
          )
        )
        && (
          !request.resource.data.keys().hasAny(['assessmentVersion'])
          || (
            request.resource.data.assessmentVersion is string
            && request.resource.data.assessmentVersion.size() >= 1
            && request.resource.data.assessmentVersion.size() <= 120
          )
        );
    }

    function isValidOptionalQuestionResponses() {
      return !request.resource.data.keys().hasAny(['questionResponses'])
        || (
          request.resource.data.questionResponses is list
          && request.resource.data.questionResponses.size() <= 300
        );
    }

    function isValidOptionalLearningLocation() {
      return !request.resource.data.keys().hasAny(['learningLocation'])
        || request.resource.data.learningLocation in ['home', 'school'];
    }

    function isValidCardEdit() {
      return request.resource.data.keys().hasOnly([
          'description',
          'icon',
          'sortOrder',
          'title',
          'underConstruction',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.keys().hasAll([
          'description',
          'icon',
          'title',
          'updatedAt',
          'updatedBy'
        ])
        && request.resource.data.description is string
        && request.resource.data.description.size() > 0
        && request.resource.data.description.size() <= 240
        && request.resource.data.icon is string
        && request.resource.data.icon.size() > 0
        && request.resource.data.icon.size() <= 500
        && (
          !request.resource.data.keys().hasAny(['sortOrder'])
          || (
            request.resource.data.sortOrder is number
            && request.resource.data.sortOrder >= 0
            && request.resource.data.sortOrder <= 200
          )
        )
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 80
        && (
          !request.resource.data.keys().hasAny(['underConstruction'])
          || request.resource.data.underConstruction is bool
        )
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.updatedBy == request.auth.token.email;
    }

    function isValidTeacherLog() {
      return request.resource.data.keys().hasOnly([
          'action',
          'cardKey',
          'email',
          'timestamp'
        ])
        && request.resource.data.keys().hasAll([
          'action',
          'cardKey',
          'email',
          'timestamp'
        ])
        && request.resource.data.action in [
          'enter-edit-mode',
          'exit-edit-mode',
          'reset-card',
          'update-card',
          'update-card-order'
        ]
        && (
          request.resource.data.cardKey == null
          || (
            request.resource.data.cardKey is string
            && isValidCardId(request.resource.data.cardKey)
          )
        )
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.timestamp is timestamp;
    }

    function isValidScholar() {
      return request.resource.data.keys().hasOnly([
          'active',
          'createdAt',
          'firstName',
          'firstNameKey',
          'includeInReports',
          'lastName',
          'lastNameKey',
          'teacherEmail',
          'trackingInitials',
          'updatedAt'
        ])
        && request.resource.data.keys().hasAll([
          'active',
          'createdAt',
          'firstName',
          'firstNameKey',
          'lastName',
          'lastNameKey',
          'teacherEmail',
          'updatedAt'
        ])
        && request.resource.data.active is bool
        && isValidName(request.resource.data.firstName)
        && isValidName(request.resource.data.lastName)
        && isValidNameKey(request.resource.data.firstNameKey)
        && isValidNameKey(request.resource.data.lastNameKey)
        && isAuthorizedRosterTeacherEmail(request.resource.data.teacherEmail)
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (
          !request.resource.data.keys().hasAny(['trackingInitials'])
          || isValidTrackingInitials(request.resource.data.trackingInitials)
        )
        && (
          !request.resource.data.keys().hasAny(['includeInReports'])
          || request.resource.data.includeInReports is bool
        );
    }

    function isValidIndividualResult() {
      return request.resource.data.keys().hasOnly([
          'assessmentId',
          'assessmentVersion',
          'attempts',
          'categoryScores',
          'completedAt',
          'createdAt',
          'gameId',
          'gameTitle',
          'incorrectSelections',
          'learningLocation',
          'levelId',
          'levelIndex',
          'levelName',
          'masteredLevel',
          'masteryCount',
          'masteryEarned',
          'masteryTarget',
          'missedCount',
          'missedQuestions',
          'mode',
          'percent',
          'questionResponses',
          'responseTimesMs',
          'schemaVersion',
          'scholarFirstName',
          'scholarFirstNameKey',
          'scholarId',
          'score',
          'soundSafariComplete',
          'teacherEmail',
          'totalQuestions'
        ])
        && request.resource.data.keys().hasAll([
          'attempts',
          'completedAt',
          'createdAt',
          'gameId',
          'gameTitle',
          'incorrectSelections',
          'missedCount',
          'missedQuestions',
          'mode',
          'percent',
          'schemaVersion',
          'scholarFirstName',
          'scholarFirstNameKey',
          'scholarId',
          'score',
          'teacherEmail',
          'totalQuestions'
        ])
        && request.resource.data.schemaVersion == 1
        && (
          request.resource.data.mode == 'individual-complete'
          || (
            request.resource.data.mode == 'practice-complete'
            && request.resource.data.gameId in [
              'math-starting-point-quest',
              'skills-starting-point'
            ]
          )
        )
        && request.resource.data.teacherEmail == 'unassigned'
        && request.resource.data.scholarId == null
        && isValidName(request.resource.data.scholarFirstName)
        && isValidNameKey(request.resource.data.scholarFirstNameKey)
        && isValidPublicGameId(request.resource.data.gameId)
        && request.resource.data.gameTitle is string
        && request.resource.data.gameTitle.size() > 0
        && request.resource.data.gameTitle.size() <= 80
        && request.resource.data.score is int
        && request.resource.data.score >= 0
        && (
          (
            request.resource.data.gameId == 'ckla-unit-1-word-builder-blast'
            && request.resource.data.score <= 34
            && request.resource.data.totalQuestions == 34
            && request.resource.data.missedCount <= 34
            && request.resource.data.missedQuestions.size() <= 34
          )
          || (
            isSharedCklaUnitGame()
            && isSharedCklaResultTotalsValid()
            && isSoundSafariMasteryFieldsValid()
          )
        )
        && request.resource.data.percent is int
        && request.resource.data.percent >= 0
        && request.resource.data.percent <= 100
        && request.resource.data.attempts is int
        && request.resource.data.attempts >= 0
        && request.resource.data.attempts <= 100
        && request.resource.data.missedCount is int
        && request.resource.data.missedCount >= 0
        && request.resource.data.incorrectSelections is list
        && request.resource.data.incorrectSelections.size() <= 100
        && request.resource.data.missedQuestions is list
        && request.resource.data.completedAt is timestamp
        && request.resource.data.createdAt is timestamp
        && isValidOptionalAssessmentMetadata()
        && isValidOptionalCategoryScores()
        && isValidOptionalLearningLocation()
        && isValidOptionalQuestionResponses()
        && isValidOptionalResponseTimes();
    }

    function isValidQpsResult() {
      return isTeacherEditor()
        && request.resource.data.keys().hasOnly([
          'assessmentId',
          'assessmentVersion',
          'attempts',
          'categoryScores',
          'completedAt',
          'createdAt',
          'gameId',
          'gameTitle',
          'incorrectSelections',
          'learningLocation',
          'levelId',
          'levelIndex',
          'levelName',
          'missedCount',
          'missedQuestions',
          'mode',
          'percent',
          'questionResponses',
          'responseTimesMs',
          'schemaVersion',
          'scholarFirstName',
          'scholarFirstNameKey',
          'scholarId',
          'score',
          'teacherEmail',
          'totalQuestions'
        ])
        && request.resource.data.keys().hasAll([
          'assessmentId',
          'assessmentVersion',
          'attempts',
          'categoryScores',
          'completedAt',
          'createdAt',
          'gameId',
          'gameTitle',
          'incorrectSelections',
          'learningLocation',
          'levelId',
          'levelIndex',
          'levelName',
          'missedCount',
          'missedQuestions',
          'mode',
          'percent',
          'questionResponses',
          'responseTimesMs',
          'schemaVersion',
          'scholarFirstName',
          'scholarFirstNameKey',
          'scholarId',
          'score',
          'teacherEmail',
          'totalQuestions'
        ])
        && request.resource.data.schemaVersion == 1
        && request.resource.data.assessmentId == 'qps-screener'
        && request.resource.data.gameId == 'qps-screener'
        && request.resource.data.gameTitle == 'QPS Screener'
        && request.resource.data.mode == 'teacher-qps-screener'
        && request.resource.data.learningLocation == 'school'
        && request.resource.data.levelId == 'qps-full-screener'
        && request.resource.data.levelIndex == 0
        && request.resource.data.levelName == 'QPS Screener'
        && request.resource.data.attempts == 1
        && isValidName(request.resource.data.scholarFirstName)
        && isValidNameKey(request.resource.data.scholarFirstNameKey)

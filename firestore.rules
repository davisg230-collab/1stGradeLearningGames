    function isValidGameLevelControl(control, levelCount) {
      return control is map
        && control.keys().hasOnly([
          'commandId',
          'lockedLevelIndexes',
          'masteryCounts',
          'masteryOverrideLevelIndexes',
          'restartLevelIndex',
          'unlockedLevelIndexes'
        ])
        && control.keys().hasAll([
          'commandId',
          'lockedLevelIndexes',
          'masteryCounts',
          'masteryOverrideLevelIndexes',
          'restartLevelIndex',
          'unlockedLevelIndexes'
        ])
        && control.commandId is string
        && control.commandId.matches('^[A-Za-z0-9-]{10,80}$')
        && control.lockedLevelIndexes is list
        && control.lockedLevelIndexes.size() <= levelCount
        && control.masteryCounts is list
        && control.masteryCounts.size() == levelCount
        && control.masteryOverrideLevelIndexes is list
        && control.masteryOverrideLevelIndexes.size() <= levelCount
        && control.restartLevelIndex is int
        && control.restartLevelIndex >= -1
        && control.restartLevelIndex < levelCount
        && control.unlockedLevelIndexes is list
        && control.unlockedLevelIndexes.size() <= levelCount;
    }

    function isValidManagedGameControls(controls) {
      return controls is map
        && controls.keys().hasOnly([
          'unit1-zone1-sound-safari',
          'ckla-unit-2-long-vowel-quest',
          'ckla-unit-3-skills-quest',
          'ckla-unit-4-skills-quest',
          'ckla-unit-5-skills-quest',
          'ckla-unit-6-skills-quest',
          'ckla-unit-7-skills-quest',
          'letter-search-safari',
          'number-search-safari',
          'ckla-listening-learning-unit-1',
          'ckla-listening-learning-unit-2',
          'ckla-listening-learning-unit-3',
          'ckla-listening-learning-unit-4',
          'ckla-listening-learning-unit-5',
          'ckla-listening-learning-unit-6',
          'ckla-listening-learning-unit-7',
          'ckla-listening-learning-unit-8',
          'ckla-listening-learning-unit-9',
          'ckla-listening-learning-unit-10',
          'ckla-listening-learning-unit-11',
          'eureka-math-module-1',
          'eureka-math-module-2',
          'eureka-math-module-3',
          'eureka-math-module-4',
          'eureka-math-module-5',
          'eureka-math-module-6'
        ])
        && controls.size() >= 1
        && (!controls.keys().hasAny(['unit1-zone1-sound-safari'])
          || isValidGameLevelControl(controls['unit1-zone1-sound-safari'], 6))
        && (!controls.keys().hasAny(['ckla-unit-2-long-vowel-quest'])
          || isValidGameLevelControl(controls['ckla-unit-2-long-vowel-quest'], 5))
        && (!controls.keys().hasAny(['ckla-unit-3-skills-quest'])
          || isValidGameLevelControl(controls['ckla-unit-3-skills-quest'], 1))
        && (!controls.keys().hasAny(['ckla-unit-4-skills-quest'])
          || isValidGameLevelControl(controls['ckla-unit-4-skills-quest'], 1))
        && (!controls.keys().hasAny(['ckla-unit-5-skills-quest'])
          || isValidGameLevelControl(controls['ckla-unit-5-skills-quest'], 1))
        && (!controls.keys().hasAny(['ckla-unit-6-skills-quest'])
          || isValidGameLevelControl(controls['ckla-unit-6-skills-quest'], 1))
        && (!controls.keys().hasAny(['ckla-unit-7-skills-quest'])
          || isValidGameLevelControl(controls['ckla-unit-7-skills-quest'], 1))
        && (!controls.keys().hasAny(['letter-search-safari'])
          || isValidGameLevelControl(controls['letter-search-safari'], 3))
        && (!controls.keys().hasAny(['number-search-safari'])
          || isValidGameLevelControl(controls['number-search-safari'], 2))
        && (!controls.keys().hasAny(['ckla-listening-learning-unit-1'])
          || isValidGameLevelControl(controls['ckla-listening-learning-unit-1'], 1))
        && (!controls.keys().hasAny(['ckla-listening-learning-unit-2'])
          || isValidGameLevelControl(controls['ckla-listening-learning-unit-2'], 1))
        && (!controls.keys().hasAny(['ckla-listening-learning-unit-3'])
          || isValidGameLevelControl(controls['ckla-listening-learning-unit-3'], 1))
        && (!controls.keys().hasAny(['ckla-listening-learning-unit-4'])
          || isValidGameLevelControl(controls['ckla-listening-learning-unit-4'], 1))
        && (!controls.keys().hasAny(['ckla-listening-learning-unit-5'])
          || isValidGameLevelControl(controls['ckla-listening-learning-unit-5'], 1))
        && (!controls.keys().hasAny(['ckla-listening-learning-unit-6'])
          || isValidGameLevelControl(controls['ckla-listening-learning-unit-6'], 1))
        && (!controls.keys().hasAny(['ckla-listening-learning-unit-7'])
          || isValidGameLevelControl(controls['ckla-listening-learning-unit-7'], 1))
        && (!controls.keys().hasAny(['ckla-listening-learning-unit-8'])
          || isValidGameLevelControl(controls['ckla-listening-learning-unit-8'], 1))
        && (!controls.keys().hasAny(['ckla-listening-learning-unit-9'])
          || isValidGameLevelControl(controls['ckla-listening-learning-unit-9'], 1))
        && (!controls.keys().hasAny(['ckla-listening-learning-unit-10'])
          || isValidGameLevelControl(controls['ckla-listening-learning-unit-10'], 1))
        && (!controls.keys().hasAny(['ckla-listening-learning-unit-11'])
          || isValidGameLevelControl(controls['ckla-listening-learning-unit-11'], 1))
        && (!controls.keys().hasAny(['eureka-math-module-1'])
          || isValidGameLevelControl(controls['eureka-math-module-1'], 1))
        && (!controls.keys().hasAny(['eureka-math-module-2'])
          || isValidGameLevelControl(controls['eureka-math-module-2'], 1))
        && (!controls.keys().hasAny(['eureka-math-module-3'])
          || isValidGameLevelControl(controls['eureka-math-module-3'], 1))
        && (!controls.keys().hasAny(['eureka-math-module-4'])
          || isValidGameLevelControl(controls['eureka-math-module-4'], 1))
        && (!controls.keys().hasAny(['eureka-math-module-5'])
